# Ambiente
NEXT_PUBLIC_ENVIRONMENT=test

# URL da API para testes
NEXT_PUBLIC_API_URL=http://localhost:8000

# Configurações de autenticação para testes
NEXT_PUBLIC_MOCK_AUTH=true

# Configurações específicas para Cypress
NEXT_PUBLIC_CYPRESS=true

# Tempo limite para requisições em testes (em milissegundos)
NEXT_PUBLIC_API_TIMEOUT=5000

# Desabilitar animações durante testes
NEXT_PUBLIC_DISABLE_ANIMATIONS=true
